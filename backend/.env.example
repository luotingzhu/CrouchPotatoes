# 复制为 .env 并填入真实值（字段名大小写不敏感）
# 注意：.env 相对进程工作目录解析，从 backend/ 目录启动服务时放 backend/.env

# ---------- PostgreSQL（docker compose 起的容器） ----------
POSTGRES_DSN=postgresql+asyncpg://domel:domel@localhost:5432/domel

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- 消息中间件（精简栈默认内存队列；有 Kafka 时改 kafka） ----------
BROKER_BACKEND=memory
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_RAW=domel.raw_data
KAFKA_GROUP_INGEST=domel-ingest

# ---------- 进程内调度（替代 Airflow 定时触发） ----------
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=300

# ---------- 向量库（pgvector | qdrant | milvus） ----------
VECTOR_BACKEND=pgvector

# ---------- 对话模型（OpenAI 兼容协议） ----------
# OpenAI 官方：OPENAI_API_KEY=sk-xxx，OPENAI_BASE_URL 留空
# DeepSeek  ：OPENAI_BASE_URL=https://api.deepseek.com/v1 ，LLM_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 向量模型（对话服务商若无 embeddings 接口，必须单独配置） ----------
# 示例：SiliconFlow 的 BAAI/bge-m3（1024 维，中文检索效果好且免费）
# 注意：EMBEDDING_DIM 必须与 db/schema.sql 中 vector(N) 保持一致，改模型需同步改 DDL 并重跑
#       scripts/backfill_embeddings.py
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---------- 报告生成窗口 ----------
REPORT_LOOKBACK_HOURS=72

# ---------- 管理员模式（解锁“后端同步状态”模块） ----------
ADMIN_PASSWORD=Ch11seburger
ADMIN_SESSION_TTL=28800
